[Unit]
Description=Ada Context Core
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ada
Group=ada
WorkingDirectory=/srv/ada/context-core
EnvironmentFile=/etc/ada/context_core.env
ExecStart=/srv/ada/context-core/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8791 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ada /var/log/ada
UMask=0077

[Install]
WantedBy=multi-user.target
