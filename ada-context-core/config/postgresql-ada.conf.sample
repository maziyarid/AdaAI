# Conservative starting values for a small 4-vCPU / low-RAM production VPS.
# Measure before changing globally; these are not universal guarantees.
max_connections = 50
shared_buffers = 256MB
effective_cache_size = 768MB
work_mem = 4MB
maintenance_work_mem = 64MB
wal_level = replica
archive_mode = on
# archive_command must copy WAL to a durable off-host-backed target; configure per deployment.
