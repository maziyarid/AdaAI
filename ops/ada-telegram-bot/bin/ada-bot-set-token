#!/usr/bin/env python3
import getpass
import json
import os
import subprocess
import sys
import urllib.request
from pathlib import Path

ENV_FILE = Path("/etc/ada-telegram-bot.env")

if os.geteuid() != 0:
    raise SystemExit("Run this command with sudo.")

token = getpass.getpass("BotFather token (hidden): ").strip()
if len(token) < 20 or ":" not in token or "\n" in token or "\r" in token:
    raise SystemExit("Token format does not look valid.")

try:
    with urllib.request.urlopen(
        f"https://api.telegram.org/bot{token}/getMe",
        timeout=15,
    ) as response:
        result = json.loads(response.read().decode("utf-8"))
except Exception as exc:
    raise SystemExit(f"Could not validate token with Telegram: {exc}")

if not result.get("ok"):
    raise SystemExit("Telegram rejected the token.")

username = (result.get("result") or {}).get("username", "unknown")
lines = ENV_FILE.read_text(encoding="utf-8").splitlines() if ENV_FILE.exists() else []
new_lines = []
replaced = False
for line in lines:
    if line.startswith("TELEGRAM_BOT_TOKEN="):
        new_lines.append("TELEGRAM_BOT_TOKEN=" + token)
        replaced = True
    else:
        new_lines.append(line)
if not replaced:
    new_lines.insert(0, "TELEGRAM_BOT_TOKEN=" + token)

tmp = ENV_FILE.with_suffix(".tmp")
tmp.write_text("\n".join(new_lines) + "\n", encoding="utf-8")
os.chmod(tmp, 0o640)
subprocess.run(["chown", "root:adabot", str(tmp)], check=True)
os.replace(tmp, ENV_FILE)

subprocess.run(["systemctl", "daemon-reload"], check=True)
subprocess.run(["systemctl", "restart", "ada-telegram-bot.service"], check=True)
active = subprocess.run(
    ["systemctl", "is-active", "ada-telegram-bot.service"],
    check=False,
    capture_output=True,
    text=True,
).stdout.strip()

print(f"Validated @{username}; ada-telegram-bot.service is {active}.")
