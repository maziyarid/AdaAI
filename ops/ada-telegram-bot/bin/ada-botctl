#!/usr/bin/env python3
import argparse, datetime as dt, json, os, sqlite3, subprocess
from pathlib import Path

STATE=Path("/var/lib/ada-telegram-bot")
DB=STATE/"state.sqlite3"
KILL=STATE/"commands.disabled"
BACKUPS=STATE/"backups"

def require_root():
    if os.geteuid()!=0:
        raise SystemExit("This command requires sudo/root.")

def run_as_adabot(args):
    return subprocess.run(["/usr/sbin/runuser","-u","adabot","--",*args],check=False,text=True,capture_output=True)

def health():
    p=run_as_adabot(["/usr/bin/python3","/opt/ada-telegram-bot/healthcheck.py"])
    print((p.stdout or p.stderr).strip())
    return p.returncode

def queue():
    require_root()
    c=sqlite3.connect(f"file:{DB}?mode=ro",uri=True)
    out={
      "inbound":dict(c.execute("select state,count(*) from inbound group by state").fetchall()),
      "outbox":dict(c.execute("select status,count(*) from outbox group by status").fetchall()),
      "feedback":dict(c.execute("select status,count(*) from feedback group by status").fetchall()),
    }
    c.close()
    print(json.dumps(out,sort_keys=True))
    return 0

def set_kill(enabled):
    require_root()
    if enabled:
        KILL.touch(exist_ok=True); os.chmod(KILL,0o600)
    else:
        try: KILL.unlink()
        except FileNotFoundError: pass
    print(json.dumps({"commands_disabled":enabled}))
    return 0

def backup():
    require_root()
    BACKUPS.mkdir(parents=True,exist_ok=True)
    stamp=dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    dest=BACKUPS/("state-"+stamp+".sqlite3")
    src=sqlite3.connect(f"file:{DB}?mode=ro",uri=True)
    dst=sqlite3.connect(dest)
    with dst: src.backup(dst)
    src.close(); dst.close()
    os.chmod(dest,0o600)
    print(str(dest))
    return 0

def status():
    p=subprocess.run(["systemctl","is-active","ada-telegram-bot.service"],text=True,capture_output=True)
    print("service="+(p.stdout.strip() or "unknown"))
    print("commands_disabled="+str(KILL.exists()).lower())
    if DB.exists(): print("state_db_mode="+oct(DB.stat().st_mode & 0o777))
    return health()

def main():
    ap=argparse.ArgumentParser()
    sub=ap.add_subparsers(dest="cmd",required=True)
    for name in ("status","health","queue","disable-commands","enable-commands","backup-state"):
        sub.add_parser(name)
    a=ap.parse_args()
    return {
      "status":status,
      "health":health,
      "queue":queue,
      "disable-commands":lambda:set_kill(True),
      "enable-commands":lambda:set_kill(False),
      "backup-state":backup,
    }[a.cmd]()

if __name__=="__main__":
    raise SystemExit(main())
