[Unit]
Description=Check durable portfolio-dispatcher heartbeat
After=maziyar-portfolio-dispatcher.service
OnFailure=maziyar-portfolio-dispatcher-recover.service

[Service]
Type=oneshot
User=maziyarid
Group=maziyarid
ExecStart=/usr/bin/python3 /srv/maziyar-ai-src/AdaAI/ops/portfolio-dispatcher/portfolio_dispatcher_watchdog.py --sqlite /srv/maziyar-wp-mcp/state/factory.sqlite3 --max-heartbeat-age 180
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/srv/maziyar-wp-mcp/state /srv/maziyar-ai-src/AdaAI/ops/portfolio-dispatcher
