[Unit]
Description=Rate-limited recovery of stale portfolio dispatcher
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/systemctl try-restart maziyar-portfolio-dispatcher.service
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=false
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
